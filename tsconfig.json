{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "vscode": ["./vscode.d.ts"]
    }
  },
  "include": [
	"src",
	"vscode.d.ts",
	"vscode.proposed.chatProvider.d.ts",
	"vscode.proposed.languageModelThinkingPart.d.ts"
  ]
}